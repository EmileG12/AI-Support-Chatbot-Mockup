ANTHROPIC_API_KEY=
# Local dev: Supabase CLI instance. In production, use your hosted Supabase project's URL/key instead.
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_SERVICE_ROLE_KEY=
PORT=3001
APP_USERNAME=
APP_PASSWORD=
COOKIE_SECRET=
# Local dev: Vite dev server. In production, set to the deployed frontend's origin (e.g. https://your-app.vercel.app).
FRONTEND_ORIGIN=http://localhost:5173
# Set to "production" on Render (or any prod host) so auth cookies get Secure + SameSite=None.
NODE_ENV=development
